# Rosa Beauty — frontend env vars
# Copy this to `.env.local` (Vite reads it automatically) and fill in your
# Supabase project values. NEVER put the service_role key here — the anon key
# is safe to ship to the browser because Row Level Security protects data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
